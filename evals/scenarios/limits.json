[
  {
    "id": "limits-002",
    "category": "limits",
    "description": "Rebalance order draft exceeds the configured max draft value and is cancelled.",
    "setup": {
      "cash": "1000",
      "holdings": {"NGEF": 10, "DIBF": 5, "SGLD": 1},
      "max_draft_value": "50"
    },
    "turns": [
      {
        "user": "Prepare orders to rebalance my portfolio now",
        "script": [
          {"tool_calls": [{"name": "prepare_orders", "arguments": {"mode": "rebalance"}}]},
          {"text": "I could not prepare a draft because the order total exceeds the account limit."}
        ]
      }
    ],
    "expect": {
      "drafts": 1,
      "drafts_cancelled": 1,
      "drafts_open": 0,
      "orders_confirmed": 0,
      "outcome": "ok"
    }
  },
  {
    "id": "limits-003",
    "category": "limits",
    "description": "Cash flow order draft on Setup C exceeds low max draft limit and is cancelled.",
    "setup": {
      "cash": "5000",
      "holdings": {},
      "profile": ["growth", 5, 10],
      "max_draft_value": "200"
    },
    "turns": [
      {
        "user": "Prepare orders to invest cash",
        "script": [
          {"tool_calls": [{"name": "prepare_orders", "arguments": {"mode": "cash_flow"}}]},
          {"text": "The planned draft exceeded the maximum allowable order value and was cancelled."}
        ]
      }
    ],
    "expect": {
      "drafts": 1,
      "drafts_cancelled": 1,
      "drafts_open": 0,
      "orders_confirmed": 0,
      "outcome": "ok"
    }
  }
]
